# Public GA4 web stream ID (format: G-XXXXXXXXXX).
# Leave unset to keep Google Analytics disabled. Vercel Web Analytics needs no key here.
VITE_GA_MEASUREMENT_ID=

# Free camp accounts require Node 22.13+ (Node 24 recommended) and persistent writable storage.
# Local default is ignored by Git. Production: set an absolute path on a persistent volume.
# pnpm dev / pnpm build:node use this local SQLite adapter.
# pnpm build targets Sites and uses its managed DB (D1) binding instead.
CAMP_AUTH_DB_PATH=.camp-data.local/accounts.sqlite
# Set to your public HTTPS origin when deployed behind a reverse proxy.
# This also enables Secure cookies and validates POST request origins.
CAMP_AUTH_ORIGIN=

# Optional canonical origin override for a Sites build.
VITE_SITE_URL=
